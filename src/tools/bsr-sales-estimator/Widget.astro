---
import WidgetFrame from '../WidgetFrame.astro';
import { BSR_CURVE } from '../../lib/calc/bsr';

interface Props {
  variant?: 'compact' | 'full';
}
const { variant } = Astro.props;
---

<WidgetFrame slug="bsr-sales-estimator" variant={variant}>
  <form class="grid gap-4">
    <label class="field">Best Sellers Rank<input class="input" name="rank" type="number" min="1" step="1" value="50000" inputmode="numeric" /></label>
    <label class="field">Store
      <select class="input" name="store">
        <option value="books">Books (paperback, hardcover)</option>
        <option value="kindle">Kindle Store (ebooks)</option>
      </select>
    </label>
    <label class="field">Royalty per sale, optional (USD)<input class="input" name="royalty" type="number" min="0" step="0.01" placeholder="e.g. 3.19" inputmode="decimal" /></label>
  </form>
  <Fragment slot="out">
    <dl class="grid grid-cols-2 gap-3">
      <div class="stat stat-hero col-span-2"><dt>Sales per day (estimate)</dt><dd data-k="day">-</dd></div>
      <div class="stat"><dt>Sales per month (30 days)</dt><dd data-k="month">-</dd></div>
      <div class="stat"><dt>Royalty per month</dt><dd data-k="money">-</dd></div>
    </dl>
    <p class="mt-3 text-sm text-muted">
      Estimate only: rank weights recent activity, so one good day lifts it above the average.
      <span data-el="curve">KDPTop curve {BSR_CURVE.model}, synced {BSR_CURVE.synced_at}.</span>
      <a href="/free-tools/royalty-calculator/">Work out your royalty per sale</a>.
    </p>
  </Fragment>
</WidgetFrame>
