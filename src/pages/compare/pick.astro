---
import Base from '../../layouts/Base.astro';
import { FIT_SCOPES, FIT_SCOPE_INFO, FIT_LEVEL_INFO } from '../../lib/taxonomy';
import { getCompares, compareTitle } from '../../lib/compare';

const compares = await getCompares();
const fitInfo = { scopes: FIT_SCOPES, scope: FIT_SCOPE_INFO, level: FIT_LEVEL_INFO };
---

<Base
  title="Compare KDP tools side by side"
  description="Pick any two or three Amazon KDP tools and compare what they do, who they suit, price terms, KDP fit and check dates side by side."
  noindex
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Comparisons', url: '/compare/' }, { name: 'Pick tools', url: '/compare/pick/' }]}
>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/compare/">Comparisons</a> / Pick tools</nav>
  <h1 class="mt-2 text-4xl font-bold">Compare KDP tools side by side</h1>
  <p class="mt-3 max-w-2xl text-muted">
    Pick two or three tools. The page address updates as you pick, so you can bookmark or share it. Anything we have not checked is marked as such, never filled in.
  </p>

  <div class="mt-6 flex max-w-2xl flex-wrap items-center gap-2">
    <label for="pick-input" class="sr-only">Add a tool</label>
    <input id="pick-input" list="pick-list" placeholder="Add a tool by name, e.g. Atticus" class="min-w-0 flex-1 rounded-lg border border-line bg-white px-3 py-2 text-sm" autocomplete="off" />
    <datalist id="pick-list"></datalist>
    <button type="button" id="pick-add" class="btn-primary py-2">Add</button>
    <button type="button" id="pick-copy" class="rounded-lg border border-line bg-white px-3 py-2 text-sm">Copy link</button>
  </div>
  <p id="pick-msg" class="mt-2 text-sm text-muted" aria-live="polite"></p>
  <ul id="pick-chips" class="mt-3 flex flex-wrap gap-2"></ul>

  <div id="pick-table" class="mt-6"></div>
  <noscript><p class="mt-4">This page needs JavaScript. See the <a href="/compare/">written comparisons</a> or <a href="/tools/">all tools</a> instead.</p></noscript>

  {
    compares.length > 0 && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-xl font-semibold">Written comparisons</h2>
        <p class="mt-1 text-sm text-muted">Head-to-head pages with a verdict on when to choose each.</p>
        <ul class="mt-3 grid gap-x-8 gap-y-1 sm:grid-cols-2">
          {compares.map(({ cmp, a, b }) => <li><a href={`/compare/${cmp.id}/`}>{compareTitle(a, b)}</a></li>)}
        </ul>
      </section>
    )
  }

  <script type="application/json" id="fit-info" set:html={JSON.stringify(fitInfo)} />
</Base>

<script>
  type Fit = Record<string, string> & { manual_steps: string[]; checked_at?: string };
  type T = {
    id: string; name: string; url: string; page: string; tagline: string; official: boolean; related_to_directory: boolean;
    price_label: string; price_terms: string[]; platforms_label: string; category_names: string[];
    kdp: { outputs_kdp_files?: boolean; touches_kdp_account?: boolean };
    kdp_fit: Fit; best_for: string[]; not_ideal_for: string[]; cons: string[]; logo?: string;
    checked: { price?: string; features?: string; link?: string };
  };
  const KEY = 'kdp123.compare';
  const MAX = 3;
  const info = JSON.parse(document.getElementById('fit-info')!.textContent!);
  const table = document.getElementById('pick-table')!;
  const chips = document.getElementById('pick-chips')!;
  const msg = document.getElementById('pick-msg')!;
  const input = document.getElementById('pick-input') as HTMLInputElement;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const none = '<span class="text-muted">Not stated</span>';
  const list = (xs: string[]) => (xs.length ? `<ul class="list-disc pl-4">${xs.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : none);
  const yn = (v?: boolean) => (v === undefined ? none : v ? 'Yes' : 'No');

  async function main() {
  const res = await fetch('/tools.json');
  const all: T[] = (await res.json()).tools;
  const byId = new Map(all.map((t) => [t.id, t]));
  const byName = new Map(all.map((t) => [t.name.toLowerCase(), t]));
  document.getElementById('pick-list')!.innerHTML = all.map((t) => `<option value="${esc(t.name)}"></option>`).join('');

  const fromUrl = (new URLSearchParams(location.search).get('t') ?? '').split(',').filter((id) => byId.has(id));
  let ids: string[] = (fromUrl.length ? fromUrl : JSON.parse(localStorage.getItem(KEY) || '[]').filter((id: string) => byId.has(id))).slice(0, MAX);

  function save() {
    localStorage.setItem(KEY, JSON.stringify(ids));
    localStorage.setItem('kdp123.compareNames', JSON.stringify(Object.fromEntries(ids.map((id) => [id, byId.get(id)!.name]))));
    history.replaceState(null, '', ids.length ? `?t=${ids.join(',')}` : location.pathname);
  }

  const rows: [string, (t: T) => string][] = [
    ['What it is', (t) => esc(t.tagline)],
    ['Categories', (t) => esc(t.category_names.join(', '))],
    ['Best for', (t) => list(t.best_for)],
    ['Not ideal for', (t) => (t.not_ideal_for.length ? list(t.not_ideal_for) : t.cons.length ? `<span class="text-muted">Limits:</span> ${list(t.cons.slice(0, 2))}` : none)],
    ['Price', (t) => esc(t.price_label)],
    ['Price terms', (t) => (t.price_terms.length ? list(t.price_terms) : none)],
    ...info.scopes.map((k: string) => [`KDP fit: ${info.scope[k].name}`, (t: T) => {
      const level = t.kdp_fit?.[k] ?? 'unverified';
      const cls = info.level[level].badge;
      return `<span class="badge ${cls}">${esc(info.level[level].label)}</span>`;
    }] as [string, (t: T) => string]),
    ['Set up yourself', (t) => (t.kdp_fit?.manual_steps?.length ? list(t.kdp_fit.manual_steps) : none)],
    ['Outputs KDP-ready files', (t) => yn(t.kdp.outputs_kdp_files)],
    ['Touches your KDP account', (t) => yn(t.kdp.touches_kdp_account)],
    ['Platforms', (t) => (t.platforms_label ? esc(t.platforms_label) : none)],
    ['Price checked', (t) => esc(t.checked.price ?? '') || none],
    ['Features checked', (t) => esc(t.checked.features ?? '') || none],
    ['Link checked', (t) => esc(t.checked.link ?? '') || none],
  ];

  function render() {
    chips.innerHTML = ids
      .map((id) => `<li><button type="button" data-remove="${esc(id)}" class="chip" aria-label="Remove ${esc(byId.get(id)!.name)}">${esc(byId.get(id)!.name)} ×</button></li>`)
      .join('');
    input.disabled = ids.length >= MAX;
    input.placeholder = ids.length >= MAX ? `Up to ${MAX} tools; remove one to add another` : 'Add a tool by name, e.g. Atticus';
    if (ids.length < 2) {
      table.innerHTML = `<p class="rounded-lg border border-line bg-white p-4 text-muted">${ids.length ? 'Add one more tool to compare.' : 'Add two or three tools above, or tick “Compare” next to any tool in a list.'}</p>`;
      return;
    }
    const ts = ids.map((id) => byId.get(id)!);
    const head = ts
      .map((t) => `<th scope="col" class="min-w-44 px-3 py-3 align-top">
        <div class="flex items-center gap-2">${t.logo ? `<img src="${esc(new URL(t.logo).pathname)}" alt="" width="32" height="32" class="rounded-md">` : ''}<a href="${esc(t.page)}" class="text-base font-semibold">${esc(t.name)}</a></div>
        ${t.official ? '<span class="badge badge-ok mt-1">Official Amazon</span>' : ''}${t.related_to_directory ? '<span class="badge badge-warn mt-1">Same team as KDP123</span>' : ''}
        <div class="mt-1 text-xs font-normal"><a href="${esc(t.url)}" rel="noopener">Visit site</a></div></th>`)
      .join('');
    const body = rows
      .map(([label, cell]) => `<tr class="border-t border-line"><th scope="row" class="sticky left-0 w-28 bg-paper px-3 py-2 text-left align-top font-medium text-muted sm:w-40">${esc(label)}</th>${ts.map((t) => `<td class="px-3 py-2 align-top">${cell(t)}</td>`).join('')}</tr>`)
      .join('');
    table.innerHTML = `<div class="overflow-x-auto rounded-lg border border-line bg-white"><table class="w-full min-w-[560px] text-left text-sm"><thead><tr><th class="sticky left-0 w-28 bg-white sm:w-40"></th>${head}</tr></thead><tbody>${body}</tbody></table></div>
      <p class="mt-2 text-xs text-muted">From each tool’s listing, which cites the vendor’s own pages. “Not checked yet” means nobody has confirmed it; <a href="/submit/">send a correction</a> if you know.</p>`;
  }

  function add() {
    const t = byName.get(input.value.trim().toLowerCase()) ?? byId.get(input.value.trim());
    if (!t) return void (msg.textContent = input.value.trim() ? `No listing named “${input.value.trim()}”. Pick a name from the list.` : '');
    if (!ids.includes(t.id) && ids.length < MAX) ids.push(t.id);
    input.value = '';
    msg.textContent = '';
    save();
    render();
  }

  document.getElementById('pick-add')!.addEventListener('click', add);
  input.addEventListener('keydown', (e) => e.key === 'Enter' && (e.preventDefault(), add()));
  input.addEventListener('change', () => byName.has(input.value.trim().toLowerCase()) && add());
  chips.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-remove]')?.dataset.remove;
    if (!id) return;
    ids = ids.filter((x) => x !== id);
    save();
    render();
  });
  document.getElementById('pick-copy')!.addEventListener('click', async () => {
    await navigator.clipboard?.writeText(location.href);
    msg.textContent = 'Link copied.';
  });
  save();
  render();
  }
  main();
</script>
