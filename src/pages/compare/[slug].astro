---
import Base from '../../layouts/Base.astro';
import { getCompares, compareTitle } from '../../lib/compare';
import { priceLabel, platformsLabel, isoDate, outbound, SITE, type Tool } from '../../lib/site';
import { publisherRef } from '../../lib/seo';

export async function getStaticPaths() {
  return (await getCompares()).map((x) => ({ params: { slug: x.cmp.id }, props: x }));
}
const { cmp, a, b } = Astro.props;
const d = cmp.data;
const title = compareTitle(a, b);
const url = `${SITE.url}/compare/${cmp.id}/`;
const reviewed = isoDate(d.verified_at);

const fromListing = (label: string, f: (t: Tool) => string) => ({ label, a: f(a), b: f(b) });
const rows = [
  fromListing('Price', priceLabel),
  fromListing('Pricing details', (t) => t.data.pricing.note ?? '-'),
  fromListing('Refund window', (t) => (t.data.pricing.refund_days !== undefined ? `${t.data.pricing.refund_days} days` : 'Not stated')),
  fromListing('Runs on', (t) => platformsLabel(t) || '-'),
  fromListing('Makes KDP-ready files', (t) => (t.data.kdp.outputs_kdp_files ? 'Yes' : 'No')),
  ...d.rows,
  fromListing('Listing last checked', (t) => isoDate(t.data.verified_at) ?? '-'),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${title} for KDP publishers`,
    description: d.answer,
    url,
    dateModified: reviewed,
    author: publisherRef,
    publisher: publisherRef,
    about: [a, b].map((t) => ({ '@type': 'SoftwareApplication', name: t.data.name, url: t.data.url })),
    citation: [...new Set([...a.data.sources, ...b.data.sources])],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [{ '@type': 'Question', name: d.question, acceptedAnswer: { '@type': 'Answer', text: d.answer } }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Comparisons', item: `${SITE.url}/compare/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={title} titleVariants={[`${title} for KDP: Pricing & Features`, `${title}: Pricing & Features`, `${title} for KDP`, title]} description={d.answer} type="article" modified={d.verified_at.toISOString().slice(0, 10)} jsonLd={jsonLd} searchable>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/compare/">Comparisons</a> / {title}</nav>

  <article class="mt-2 max-w-4xl" data-pagefind-filter="type:Comparison" data-pagefind-meta="type:Comparison">
    <h1 class="text-4xl font-bold">{title} for KDP publishers</h1>
    <p class="mt-2 text-sm text-muted">Reviewed {reviewed} from both vendors' own pages. Neither vendor paid to be compared.</p>

    <section class="answer mt-6" aria-label="Short answer">
      <p class="font-medium">{d.question}</p>
      <p class="mt-2 leading-7">{d.answer}</p>
    </section>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[560px] border-collapse rounded-lg border border-line bg-white text-sm">
        <caption class="sr-only">{title} side by side</caption>
        <thead>
          <tr class="border-b border-line bg-paper text-left">
            <th scope="col" class="w-1/5 px-4 py-2"></th>
            <th scope="col" class="px-4 py-2"><a href={`/t/${a.id}/`}>{a.data.name}</a></th>
            <th scope="col" class="px-4 py-2"><a href={`/t/${b.id}/`}>{b.data.name}</a></th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class="border-b border-line align-top last:border-0">
                <th scope="row" class="px-4 py-2 text-left font-normal text-muted">{r.label}</th>
                <td class="px-4 py-2">{r.a}</td>
                <td class="px-4 py-2">{r.b}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        [
          [a, d.choose_a],
          [b, d.choose_b],
        ].map(([t, why]) => {
          const tool = t as Tool;
          const link = outbound(tool);
          return (
            <section class="rounded-lg border border-line bg-white p-4">
              <h2 class="text-xl font-semibold">Choose {tool.data.name} if…</h2>
              <p class="mt-2 leading-7">{why as string}</p>
              <p class="mt-3 text-sm"><a href={`/t/${tool.id}/`}>Full listing</a> · <a href={link.href} rel={link.rel}>Visit site</a></p>
            </section>
          );
        })
      }
    </div>

    <h2 class="mt-10 text-2xl font-semibold">Sources</h2>
    <ul class="mt-2 list-disc pl-6 text-sm">{[...new Set([...a.data.sources, ...b.data.sources])].map((s) => <li><a href={s} rel="noopener">{s}</a></li>)}</ul>

    <p class="mt-8 text-sm text-muted">Prices change. Each side's figures come from its listing, which links the vendor page we checked. <a href="/submit/">Report a change</a>.</p>
  </article>
</Base>
