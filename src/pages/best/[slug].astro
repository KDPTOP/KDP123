---
import Base from '../../layouts/Base.astro';
import { getBest } from '../../lib/best';
import { priceLabel, priceShort, isoDate, outbound, SITE } from '../../lib/site';
import ToolLogo from '../../components/ToolLogo.astro';
import { publisherRef } from '../../lib/seo';
import { categoryBySlug } from '../../lib/taxonomy';

export async function getStaticPaths() {
  return (await getBest()).map(({ list, tools }) => ({ params: { slug: list.id }, props: { list, tools } }));
}
const { list, tools } = Astro.props;
const d = list.data;
const byId = new Map(tools.map((t) => [t.id, t]));
const url = `${SITE.url}/best/${list.id}/`;
const reviewed = isoDate(d.verified_at);
const category = d.category ? categoryBySlug(d.category) : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.answer,
    url,
    dateModified: reviewed,
    author: publisherRef,
    publisher: publisherRef,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: d.title,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: d.picks.length,
    itemListElement: d.picks.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: byId.get(p.tool)!.data.name, url: `${SITE.url}/t/${p.tool}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Best-of lists', item: `${SITE.url}/best/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Base title={d.title} titleVariants={[d.seo_title ?? d.title]} description={d.answer} type="article" modified={d.verified_at.toISOString().slice(0, 10)} jsonLd={jsonLd} markdownAlt={`/best/${list.id}.md`} searchable aside>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/best/">Best-of lists</a> / {d.title}</nav>

  <article class="mt-2" data-pagefind-filter="type:Best-of list" data-pagefind-meta="type:Guide">
    <h1 class="text-4xl font-bold">{d.title}</h1>
    <p class="mt-2 text-sm text-muted">Reviewed {reviewed}. No vendor paid to be listed or ranked. Affiliate links, where they exist, are marked.</p>

    <section class="answer mt-6" aria-label="Short answer">
      <p class="font-medium">{d.question}</p>
      <p class="mt-2 leading-7">{d.answer}</p>
    </section>

    <h2 class="mt-8 text-2xl font-semibold">How we chose</h2>
    <ul class="mt-2 list-disc pl-6 leading-7">{d.criteria.map((c) => <li>{c}</li>)}</ul>
    <p class="mt-2 text-sm text-muted">Facts behind each pick (price, platforms, KDP fit) come from the listing pages, which cite their sources. See the <a href="/methodology/">methodology</a>.</p>

    <h2 class="mt-8 text-2xl font-semibold">The picks</h2>
    <ol class="mt-3 space-y-5">
      {
        d.picks.map((p, i) => {
          const t = byId.get(p.tool)!;
          const link = outbound(t);
          return (
            <li id={`pick-${t.id}`} class="scroll-mt-20 rounded-lg border border-line bg-white p-4">
              <p class="text-xs font-medium text-muted">{i + 1}. {p.label}</p>
              <h3 class="mt-1 text-xl font-semibold">
                <a href={`/t/${t.id}/`}>{t.data.name}</a>
                {t.data.related_to_directory && <span class="badge badge-warn ml-2 align-middle">Same team as KDP123</span>}
                {t.data.official && <span class="badge badge-ok ml-2 align-middle">Official Amazon</span>}
              </h3>
              <p class="mt-2 leading-7">{p.why}</p>
              <p class="mt-2 text-sm text-muted">
                {priceLabel(t)} · Checked {isoDate(t.data.verified_at)} · <a href={link.href} rel={link.rel}>Visit site</a>
                {t.data.affiliate && <span> (affiliate link)</span>}
              </p>
            </li>
          );
        })
      }
    </ol>

    {
      d.not_included.length > 0 && (
        <>
          <h2 class="mt-8 text-2xl font-semibold">Considered, not picked</h2>
          <ul class="mt-2 list-disc pl-6 leading-7">
            {d.not_included.map((n) => <li><a href={`/t/${n.tool}/`}>{byId.get(n.tool)!.data.name}</a>: {n.why}</li>)}
          </ul>
        </>
      )
    }

    {category && <p class="mt-8">Every listing in this area: <a href={`/c/${category.slug}/`}>{category.name}</a>.</p>}
    <p class="mt-4 text-sm text-muted">Think a tool is missing or a pick is wrong? <a href="/submit/">Tell us</a>. <a href={`/best/${list.id}.md`}>Plain-text version</a>.</p>
  </article>

  <Fragment slot="aside">
    <section class="aside-box" aria-labelledby="aside-picks">
      <h2 id="aside-picks" class="aside-h">The picks</h2>
      <ol class="mt-1.5 -mx-1.5">
        {d.picks.map((p) => {
          const t = byId.get(p.tool)!;
          return (
            <li>
              <a href={`#pick-${t.id}`} class="aside-link">
                <ToolLogo tool={t} size={20} />
                <span class="min-w-0 flex-1 truncate">{t.data.name}</span>
                <span class="shrink-0 text-xs text-muted">{t.data.related_to_directory ? 'Same team' : priceShort(t)}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
    {category && (
      <section class="aside-box text-sm" aria-labelledby="aside-cat">
        <h2 id="aside-cat" class="aside-h">Every listing in this area</h2>
        <p class="mt-1.5"><a href={`/c/${category.slug}/`}>{category.name}</a>, with filters by price and KDP fit.</p>
      </section>
    )}
  </Fragment>
</Base>
