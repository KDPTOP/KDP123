---
import Base from '../../layouts/Base.astro';
import ToolTable from '../../components/ToolTable.astro';
import TeamPick from '../../components/TeamPick.astro';
import { getTools, SITE } from '../../lib/site';
import { STAGES, categoriesOfStage } from '../../lib/taxonomy';

export function getStaticPaths() {
  return STAGES.map((s) => ({ params: { stage: s.slug }, props: { stage: s } }));
}
const { stage } = Astro.props;
const tools = await getTools();
const cats = categoriesOfStage(stage.slug).filter((c) => tools.some((t) => t.data.categories.includes(c.slug)));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `KDP tools for ${stage.name.toLowerCase()}`,
  url: `${SITE.url}/stages/${stage.slug}/`,
  description: stage.blurb,
};
---

<Base title={`KDP ${stage.name}: tools and resources`} description={`${stage.blurb} Verified tools with prices and last-checked dates.`} jsonLd={jsonLd}>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / {stage.name}</nav>
  <h1 class="mt-2 text-4xl font-bold">{stage.name}</h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">{stage.blurb}</p>
  <p class="mt-2 text-sm text-muted">Listings are sorted by name. A tool can appear under more than one category and stage.</p>
  {stage.slug === 'research' && <div class="mt-6 max-w-3xl"><TeamPick /></div>}
  {
    cats.map((c) => {
      const list = tools.filter((t) => t.data.categories.includes(c.slug));
      return (
        <section class="mt-10" aria-labelledby={`c-${c.slug}`}>
          <h2 id={`c-${c.slug}`} class="text-2xl font-semibold">
            <a href={`/c/${c.slug}/`} class="text-ink">{c.name}</a>
          </h2>
          <p class="mt-1 text-sm text-muted">{c.blurb}</p>
          <div class="mt-3"><ToolTable tools={list} /></div>
        </section>
      );
    })
  }
</Base>
