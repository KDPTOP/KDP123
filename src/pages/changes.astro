---
import Base from '../layouts/Base.astro';
import { getTools, isoDate, SITE } from '../lib/site';

const tools = await getTools();
const rows = tools
  .flatMap((t) => t.data.price_history.map((h) => ({ tool: t, ...h })))
  .sort((a, b) => b.date.getTime() - a.date.getTime() || a.tool.data.name.localeCompare(b.tool.data.name));
const kindLabel = { price: 'Price change', plan: 'Plans recorded', correction: 'Our correction', status: 'Status change' } as const;
const recent = [...tools]
  .filter((t) => t.data.verified_at)
  .sort((a, b) => b.data.verified_at!.getTime() - a.data.verified_at!.getTime())
  .slice(0, 20);
const url = `${SITE.url}/changes/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'KDP tool price and plan changes',
    url,
    dateModified: rows[0] ? isoDate(rows[0].date) : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Changes', item: url },
    ],
  },
];
---

<Base title="KDP tool price and plan changes" description="A dated log of price, plan and status changes we have seen on KDP tool vendors' own pages, and corrections we made to this directory." jsonLd={jsonLd} searchable>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / Changes</nav>
  <section class="mt-2 max-w-3xl">
    <h1 class="text-4xl font-bold">Price and plan changes</h1>
    <p class="mt-4 text-lg text-muted">
      Every row is something we read on the vendor's own pricing page on that date, or a correction we made to our own listing.
      The full history is in the <a href={SITE.github}>public repository</a>.
    </p>
  </section>

  <div class="mt-8 overflow-x-auto rounded-lg border border-line bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-paper text-muted"><tr><th class="px-4 py-2">Date</th><th class="px-4 py-2">Tool</th><th class="px-4 py-2">Change</th><th class="px-4 py-2">Details</th></tr></thead>
      <tbody class="divide-y divide-line">
        {rows.map((r) => (
          <tr>
            <td class="whitespace-nowrap px-4 py-2">{isoDate(r.date)}</td>
            <td class="px-4 py-2"><a href={`/t/${r.tool.id}/`}>{r.tool.data.name}</a></td>
            <td class="whitespace-nowrap px-4 py-2">{kindLabel[r.kind]}</td>
            <td class="px-4 py-2">{r.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 text-2xl font-semibold">Recently checked listings</h2>
  <p class="mt-2 text-sm text-muted">Checked means we re-read the vendor's site and confirmed the price and description.</p>
  <ul class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
    {recent.map((t) => <li><a href={`/t/${t.id}/`}>{t.data.name}</a> <span class="text-muted">{isoDate(t.data.verified_at)}</span></li>)}
  </ul>
</Base>
