---
import Base from '../../layouts/Base.astro';
import ToolTable from '../../components/ToolTable.astro';
import { getTools, SITE } from '../../lib/site';
import { nonEmpty, stageBySlug } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const all = await getTools();
  return nonEmpty(all.flatMap((t) => t.data.categories)).map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}
const { category } = Astro.props;
const all = await getTools();
const tools = all.filter((t) => t.data.categories.includes(category.slug));
const stage = stageBySlug(category.stage);
const url = `${SITE.url}/c/${category.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.name,
    url,
    description: category.blurb,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/t/${t.id}/`,
        name: t.data.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: stage?.name, item: `${SITE.url}/stages/${category.stage}/` },
      { '@type': 'ListItem', position: 3, name: category.name, item: url },
    ],
  },
];
---

<Base title={`${category.name} for KDP`} description={`${category.blurb} ${tools.length} listed, with prices and last-checked dates.`} jsonLd={jsonLd}>
  <nav class="text-sm text-muted" aria-label="Breadcrumb">
    <a href="/">Home</a> / <a href={`/stages/${category.stage}/`}>{stage?.name}</a> / {category.name}
  </nav>
  <h1 class="mt-2 text-4xl font-bold">{category.name}</h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">{category.blurb}</p>
  <div class="mt-6"><ToolTable tools={tools} /></div>
</Base>
