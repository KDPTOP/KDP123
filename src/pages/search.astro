---
import Base from '../layouts/Base.astro';
---

<Base aside title="Search KDP123" description="Search every KDP123 tool listing, KDP fact, guide, comparison and free calculator." noindex>
  <h1 class="text-4xl font-bold">Search</h1>
  <p class="mt-3 max-w-2xl text-muted">Searches tool listings, KDP facts, guides, comparisons, free calculators and reports. Each result shows its type; listings also show price and check date. To filter tools by price or KDP-ready output, use <a href="/tools/">All tools</a>.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search" class="mt-6 max-w-3xl"></div>
  <noscript><p class="mt-4">Search needs JavaScript. Browse <a href="/tools/">all tools</a> or <a href="/facts/">KDP facts</a> instead.</p></noscript>
</Base>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  // Type label, and for listings the price and check date, in front of each result's excerpt.
  const processResult = (r) => {
    const m = r.meta || {};
    const bits = [m.price, m.checked && `checked ${m.checked}`].filter(Boolean).map(esc).join(' · ');
    const label = m.type ? `<span class="kdp-type">${esc(m.type)}</span>` : '';
    if (label || bits) r.excerpt = `${label}${bits ? `<span class="kdp-meta">${bits}</span>` : ''}<br>${r.excerpt}`;
    return r;
  };
  const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false, processResult });
  const q = new URLSearchParams(location.search).get('q');
  if (q) ui.triggerSearch(q);

  // Settled searches and their result counts go to /s, a 204 endpoint the server logs without IPs. The weekly
  // review of zero-result terms decides what to list or write next.
  let timer, last = '';
  new MutationObserver(() => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const term = (document.querySelector('#search input')?.value || '').trim().toLowerCase().slice(0, 100);
      const msg = document.querySelector('#search .pagefind-ui__message')?.textContent || '';
      const m = msg.match(/^(\d+|No) results?/i);
      if (term.length < 2 || !m || term === last) return;
      last = term;
      const n = m[1].toLowerCase() === 'no' ? 0 : Number(m[1]);
      navigator.sendBeacon?.(`/s?${new URLSearchParams({ q: term, n: String(n) })}`);
    }, 1500);
  }).observe(document.getElementById('search'), { childList: true, subtree: true, characterData: true });
</script>

<style is:global>
  #search .kdp-type { display: inline-block; margin-right: 0.5rem; padding: 0 0.4rem; border: 1px solid rgb(255 122 10 / 0.35); border-radius: 4px; background: #fff4e8; color: #c2410c; font-size: 0.75rem; font-weight: 600; line-height: 1.4rem; }
  #search .pagefind-ui__result-tags { display: none; }
  #search .kdp-meta { font-size: 0.8rem; color: #5b6270; }
  #search { --pagefind-ui-primary: #111a2e; --pagefind-ui-text: #111a2e; --pagefind-ui-border: #e3e6ec; --pagefind-ui-font: inherit; --pagefind-ui-border-radius: 8px; }
</style>
