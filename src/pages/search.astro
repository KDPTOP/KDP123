---
import Base from '../layouts/Base.astro';
---

<Base title="Search kdp123" description="Search every kdp123 tool listing and KDP fact page." noindex>
  <h1 class="text-4xl font-bold">Search</h1>
  <p class="mt-3 max-w-2xl text-muted">Searches tool listings and KDP fact pages. To filter tools by price or KDP-ready output, use <a href="/tools/">All tools</a>.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search" class="mt-6 max-w-3xl"></div>
  <noscript><p class="mt-4">Search needs JavaScript. Browse <a href="/tools/">all tools</a> or <a href="/facts/">KDP facts</a> instead.</p></noscript>
</Base>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
  const q = new URLSearchParams(location.search).get('q');
  if (q) ui.triggerSearch(q);
</script>

<style is:global>
  #search { --pagefind-ui-primary: #1f4fd6; --pagefind-ui-text: #14171f; --pagefind-ui-border: #e3e6ec; --pagefind-ui-font: inherit; --pagefind-ui-border-radius: 8px; }
</style>
