---
import Base from '../../layouts/Base.astro';
import ToolBrowser from '../../components/ToolBrowser.astro';
import { getTools } from '../../lib/site';

const tools = await getTools();
---

<Base title="All KDP tools and resources" titleVariants={[`All ${tools.length} Amazon KDP Tools & Resources`, "All KDP Tools & Resources"]} description={`All ${tools.length} Amazon KDP tools, official sources and communities, each with its price and check date. Filter by stage, price, KDP-ready output, platform and free trial.`} breadcrumbs={[{ name: "Home", url: "/" }, { name: "All tools", url: "/tools/" }]}>
  <h1 class="text-3xl font-bold md:text-4xl">All KDP tools and resources</h1>
  <p class="mt-2 max-w-3xl text-muted">{tools.length} listings, each checked on the vendor's own site. Filter by stage, price, KDP-ready output and platform; the filters stay in the address bar, so you can share a view.</p>
  <div class="mt-6"><ToolBrowser tools={tools} /></div>
</Base>
