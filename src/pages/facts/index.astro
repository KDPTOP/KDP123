---
import Base from '../../layouts/Base.astro';
import { getFacts } from '../../lib/facts';
import { FACT_TOPICS } from '../../lib/taxonomy';
import { SITE, isoDate } from '../../lib/site';

const facts = await getFacts();
const topics = FACT_TOPICS.filter((t) => facts.some((f) => f.data.topic === t.slug));
const url = `${SITE.url}/facts/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'KDP facts',
    url,
    description: 'Amazon KDP rules and numbers, each answered first and sourced to Amazon’s own help pages.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: facts.length,
      itemListElement: facts.map((f, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/facts/${f.id}/`, name: f.data.title })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'KDP facts', item: url },
    ],
  },
];
---

<Base title="KDP facts: royalties, print specs, KDP Select and content rules" description="Amazon KDP rules and numbers in one place: royalties, printing costs, trim sizes, KDP Select, AI disclosure, ISBNs and more. Each page cites Amazon’s help pages and shows when we last checked." jsonLd={jsonLd}>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / KDP facts</nav>
  <section class="mt-2 max-w-3xl">
    <h1 class="text-4xl font-bold">KDP facts</h1>
    <p class="mt-4 text-lg text-muted">
      The rules and numbers KDP publishers look up most, each answered in the first lines and sourced to Amazon’s own help pages.
      Amazon changes these often; every page shows the date we last checked it against Amazon.
    </p>
  </section>

  {
    topics.map((t) => (
      <section class="mt-10" aria-labelledby={`topic-${t.slug}`}>
        <h2 id={`topic-${t.slug}`} class="text-2xl font-semibold">{t.name}</h2>
        <ul class="mt-3 divide-y divide-line rounded-lg border border-line bg-white">
          {facts
            .filter((f) => f.data.topic === t.slug)
            .map((f) => (
              <li class="px-4 py-3">
                <a href={`/facts/${f.id}/`} class="font-medium">{f.data.title}</a>
                <p class="mt-1 text-sm text-muted">{f.data.question} <span class="whitespace-nowrap">Checked {isoDate(f.data.verified_at)}.</span></p>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>
