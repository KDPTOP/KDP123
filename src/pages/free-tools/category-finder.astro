---
import FreeToolPage from '../../components/FreeToolPage.astro';
import Widget from '../../tools/category-finder/Widget.astro';
import { SITE } from '../../lib/site';

const sources = [
  'https://kdp.amazon.com/en_US/help/topic/G201298500',
  'https://kdp.amazon.com/en_US/help/topic/G200652170',
  `${SITE.related.url}/tools/kdp-category`,
];
const faq = [
  {
    q: 'How many categories can I choose for a KDP book?',
    a: 'Three per format. You pick them in KDP from the category tree; Amazon can change or remove categories that do not match the book, and new choices can take up to 72 hours to show.',
  },
  {
    q: 'What does "not selectable in KDP" mean?',
    a: 'Some Amazon browse categories exist on the store but are not offered in KDP\'s category picker, so you cannot choose them directly. The finder shows the KDP path only for categories you can pick.',
  },
  {
    q: 'Where does the data come from?',
    a: 'From KDPTop, which crawls Amazon.com bestseller and new release lists daily for about 11,000 categories. List size and prices are from the most recent crawl shown on each result.',
  },
];
---

<FreeToolPage
  slug="category-finder"
  answer="Describe your book in a sentence, or paste an ASIN, ISBN or Amazon product link, and get Amazon.com categories that fit, with the exact path to pick in KDP, how many books compete in each, and what the current bestsellers cost."
  faq={faq}
  sources={sources}
  remote
  poweredBy="Category data and lookups by KDPTop, from the team behind KDP123. Your query is sent to KDPTop's public API to answer it. Guests get a limited number of free lookups per day."
>
  <Widget />
  <p class="mt-6 text-sm text-muted">For a Go / Crowded / Watch / Skip verdict on each category and daily list history, open the full <a href={`${SITE.related.url}/tools/kdp-category`} rel="noopener">KDPTop category finder</a>.</p>

  <Fragment slot="how">
    <h2>How to read the results</h2>
    <ul>
      <li><strong>KDP path</strong> is what to click in KDP's category picker. Results marked "not selectable" are Amazon browse categories KDP does not offer.</li>
      <li><strong>Books in category</strong> is how many products Amazon lists there. Smaller categories need fewer sales to reach the top 100.</li>
      <li><strong>Median price and reviews</strong> are for today's top 100 bestsellers: what you are competing with on price and social proof.</li>
      <li><strong>Other format</strong> is the matching category for the ebook (or print) edition, since each format picks its own three.</li>
      <li><strong>Check a category</strong> takes an Amazon category number or Best Sellers link and shows KDPTop's latest snapshot of it, including how many of today's top 100 are new releases: a high share means new books can break in.</li>
    </ul>
    <p>Example: describe the book as "cozy mystery with a baker sleuth in a seaside village", pick Paperback, and compare the suggestions. Between two honest fits, the one with fewer books and lower median reviews among its top 100 is the easier list to reach.</p>
    <p>Pick categories that describe the book honestly. Amazon removes categories that do not match the content.</p>
  </Fragment>
</FreeToolPage>
