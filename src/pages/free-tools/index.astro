---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';
import { FREE_TOOLS } from '../../lib/freeTools';

const url = `${SITE.url}/free-tools/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free KDP calculators and checkers',
    url,
    hasPart: FREE_TOOLS.map((t) => ({ '@type': 'WebApplication', name: t.name, url: `${url}${t.slug}/`, isAccessibleForFree: true })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Free tools', item: url },
    ],
  },
];
---

<Base title="Free KDP calculators and checkers" titleVariants={["Free KDP Calculators: Royalty, Cover, Price & BSR"]} description="Free KDP royalty, printing cost, cover size, ebook price, description, keyword, category and BSR tools. No sign-up, built on KDP's published rules." jsonLd={jsonLd}>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / Free tools</nav>
  <h1 class="mt-2 text-4xl font-bold">Free KDP calculators and checkers</h1>
  <p class="mt-3 max-w-3xl leading-7">Small tools for the numbers and rules every KDP book runs into. They follow Amazon's published KDP rules, link to the pages they come from, and need no account. Code is open on <a href={SITE.github}>GitHub</a>.</p>

  <ul class="mt-8 grid gap-4 md:grid-cols-2">
    {
      FREE_TOOLS.map((t) => (
        <li class="rounded-lg border border-line bg-white p-5">
          <h2 class="text-lg font-semibold"><a href={`/free-tools/${t.slug}/`}>{t.name}</a></h2>
          <p class="mt-1 text-sm leading-6 text-muted">{t.blurb}</p>
        </li>
      ))
    }
  </ul>

  <section class="mt-10 max-w-3xl rounded-lg border border-line bg-white p-5">
    <h2 class="text-lg font-semibold">Keyword research</h2>
    <p class="mt-1 text-sm leading-6 text-muted">Search volume and competition need live Amazon data, which no static calculator has. Compare the paid and free options in <a href="/c/keywords-categories/">keyword and category tools</a>, or try <a href={SITE.related.url} rel="noopener">KDPTop</a> (from the team behind KDP123) for category-level demand and competition.</p>
  </section>
</Base>
