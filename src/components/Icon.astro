---
import { iconSvg, SPRITE, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls = 'size-4' } = Astro.props;
---

{SPRITE.includes(name) ? <svg class:list={['i', cls]} aria-hidden="true"><use href={`#i-${name}`} /></svg> : <Fragment set:html={iconSvg(name, cls)} />}
