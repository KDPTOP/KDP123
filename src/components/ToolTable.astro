---
import { priceLabel, priceShort, isoDate, outbound, type Tool } from '../lib/site';
import { categoryBySlug } from '../lib/taxonomy';
import ToolLogo from './ToolLogo.astro';
import Icon from './Icon.astro';
import PinButton from './PinButton.astro';

interface Props {
  tools: Tool[];
  showCategory?: boolean;
  filterable?: boolean;
  /** Short list for the home page: name with a one-line description, price, details. No KDP or Checked columns. */
  compact?: boolean;
}
const { tools, showCategory = false, filterable = false, compact = false } = Astro.props;
// Full table: one DOM for both layouts. Below md each row is a card, so the filter script only ever hides <tr> elements.
---

{compact ? (
  <ul class="divide-y divide-line rounded-xl border border-line bg-white">
    {tools.map((t) => {
      const link = outbound(t);
      return (
        <li class="relative flex min-h-15 items-center gap-3 px-3 py-2.5">
          <ToolLogo tool={t} size={28} />
          <div class="min-w-0 flex-1">
            <a href={link.href} rel={link.rel} target="_blank" data-site={link.href} data-details={`/t/${t.id}/`} class="inline-flex max-w-full items-center gap-1 text-sm font-medium" title={`${t.data.name}: open the website`}>
              <span class="truncate">{t.data.name}</span>
              <Icon name="arrowUpRight" class="size-3 shrink-0 text-muted" />
            </a>
            <p class="line-clamp-1 text-xs text-muted">{t.data.tagline}</p>
          </div>
          <span class="max-w-36 shrink-0 text-right text-xs leading-snug text-ink">{priceShort(t)}</span>
          <span class="flex shrink-0 items-center" data-pagefind-ignore>
            <a href={`/t/${t.id}/`} class="btn-icon size-8" aria-label={`${t.data.name} details`} title={`Details, alternatives. Checked ${isoDate(t.data.verified_at)}`}><Icon name="info" class="size-4" /></a>
            <PinButton kind="tool" id={t.id} name={t.data.name} href={`/t/${t.id}/`} class="btn-icon size-8" />
          </span>
        </li>
      );
    })}
  </ul>
) : (
<div class="md:overflow-x-auto md:rounded-lg md:border md:border-line md:bg-white">
  <table class="block w-full text-left text-sm md:table md:min-w-[720px]" data-tool-table={filterable ? '' : undefined}>
    <thead class="hidden border-b border-line bg-paper text-xs text-muted md:table-header-group">
      <tr>
        <th class="px-3 py-2 font-medium">Tool</th>
        <th class="px-3 py-2 font-medium">What it is</th>
        <th class="px-3 py-2 font-medium">Price</th>
        <th class="px-3 py-2 font-medium">KDP</th>
        <th class="px-3 py-2 font-medium">Checked</th>
        <th class="px-3 py-2 font-medium"><span class="sr-only">Details</span></th>
      </tr>
    </thead>
    <tbody class="block space-y-3 md:table-row-group md:space-y-0">
      {
        tools.map((t) => {
          const link = outbound(t);
          return (
            <tr
              class="block rounded-lg border border-line bg-white p-3 align-top md:table-row md:rounded-none md:border-0 md:border-b md:p-0 md:last:border-0"
              data-price={t.data.pricing.model}
              data-official={t.data.official ? '1' : '0'}
              data-kdp-files={t.data.kdp.outputs_kdp_files ? '1' : '0'}
              data-name={t.data.name.toLowerCase()}
            >
              <td class="block md:table-cell md:px-3 md:py-3">
                <a href={link.href} rel={link.rel} target="_blank" data-site={link.href} data-details={`/t/${t.id}/`} class="inline-flex items-center gap-2 text-base font-medium md:text-sm" title={`${t.data.name}: open the website`}>
                  <ToolLogo tool={t} size={24} />
                  {t.data.name}
                  <Icon name="arrowUpRight" class="size-3.5 text-muted" />
                </a>
                <div class="mt-1 flex flex-wrap items-center gap-1">
                  <label class="inline-flex cursor-pointer items-center gap-1 text-xs text-muted" data-pagefind-ignore>
                    <input type="checkbox" data-compare={t.id} data-compare-name={t.data.name} class="size-3.5 accent-[var(--color-brand)]" /> Compare
                  </label>
                  {t.data.official && <span class="badge badge-ok">Official</span>}
                  {t.data.related_to_directory && <span class="badge badge-warn">Same team as KDP123</span>}
                  {showCategory && t.data.categories.slice(0, 2).map((c) => <span class="badge">{categoryBySlug(c)?.name}</span>)}
                </div>
              </td>
              <td class="mt-2 block text-muted md:mt-0 md:table-cell md:px-3 md:py-3">
                {t.data.tagline}
              </td>
              <td class="mt-2 block md:mt-0 md:table-cell md:whitespace-nowrap md:px-3 md:py-3">
                <span class="text-muted md:hidden">Price: </span>{priceLabel(t)}
              </td>
              <td class="mt-1 block max-md:empty:hidden md:mt-0 md:table-cell md:px-3 md:py-3">
                {(t.data.kdp.outputs_kdp_files || t.data.kdp.touches_kdp_account) && (
                  <div class="flex flex-wrap gap-1 md:whitespace-nowrap">
                    {t.data.kdp.outputs_kdp_files && <span class="badge badge-ok">KDP-ready files</span>}
                    {t.data.kdp.touches_kdp_account && <span class="badge badge-warn">Touches KDP account</span>}
                  </div>
                )}
              </td>
              <td class="mt-1 block text-xs text-muted md:mt-0 md:table-cell md:whitespace-nowrap md:px-3 md:py-3 md:text-sm">
                <span class="md:hidden">Checked </span>{isoDate(t.data.verified_at)}
              </td>
              <td class="mt-2 flex items-center gap-1 md:mt-0 md:table-cell md:whitespace-nowrap md:px-3 md:py-3" data-pagefind-ignore>
                <a href={`/t/${t.id}/`} class="inline-flex items-center gap-1 text-sm" aria-label={`${t.data.name} details`}><Icon name="info" class="size-3.5" />Details</a>
                <PinButton kind="tool" id={t.id} name={t.data.name} href={`/t/${t.id}/`} class="btn-icon size-7 align-middle" />
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
)}
