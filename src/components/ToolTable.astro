---
import { priceShort, isoDate, outbound, type Tool } from '../lib/site';
import ToolLogo from './ToolLogo.astro';
import Icon from './Icon.astro';
import PinButton from './PinButton.astro';

/** Short list for the home page: name with a one-line description, price, details. */
interface Props {
  tools: Tool[];
}
const { tools } = Astro.props;
---

<ul class="divide-y divide-line rounded-xl border border-line bg-white">
  {tools.map((t) => {
    const link = outbound(t);
    return (
      <li class="relative flex min-h-15 items-center gap-3 px-3 py-2.5">
        <ToolLogo tool={t} size={28} />
        <div class="min-w-0 flex-1">
          <a href={link.href} rel={link.rel} target="_blank" data-site={link.href} data-details={`/t/${t.id}/`} class="inline-flex max-w-full items-center gap-1 text-sm font-medium" title={`${t.data.name}: open the website`}>
            <span class="truncate">{t.data.name}</span>
            <Icon name="arrowUpRight" class="size-3 shrink-0 text-muted" />
          </a>
          <p class="line-clamp-1 text-xs text-muted">{t.data.tagline}</p>
        </div>
        <span class="max-w-36 shrink-0 text-right text-xs leading-snug text-ink">{priceShort(t)}</span>
        <span class="flex shrink-0 items-center" data-pagefind-ignore>
          <a href={`/t/${t.id}/`} class="btn-icon size-8" aria-label={`${t.data.name} details`} title={`Details, alternatives. Checked ${isoDate(t.data.verified_at)}`}><Icon name="info" class="size-4" /></a>
          <PinButton kind="tool" id={t.id} name={t.data.name} href={`/t/${t.id}/`} class="btn-icon size-8" />
        </span>
      </li>
    );
  })}
</ul>
