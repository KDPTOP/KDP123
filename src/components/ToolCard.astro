---
import ToolLogo from './ToolLogo.astro';
import Icon from './Icon.astro';
import PinButton from './PinButton.astro';
import { outbound, priceLabel, priceShort, type Tool } from '../lib/site';

interface Props {
  tool: Tool;
  /** Logo tile in a grid (default) or a one-line row. */
  layout?: 'tile' | 'row';
}
const { tool: t, layout = 'tile' } = Astro.props;
const link = outbound(t);
const details = `/t/${t.id}/`;
const sub = t.data.related_to_directory ? 'Same team' : priceShort(t);
---

<div class:list={['tool-card group relative', layout === 'row' ? 'tool-card-row' : '']} data-pagefind-ignore>
  <a
    href={link.href}
    rel={link.rel}
    target="_blank"
    data-site={link.href}
    data-details={details}
    class:list={['tc-link', layout === 'row' ? 'tc-row' : 'tc-tile']}
    title={`${t.data.name}: open the website`}
  >
    <ToolLogo tool={t} size={layout === 'row' ? 28 : 40} />
    <span class:list={['min-w-0', layout === 'row' ? 'flex-1' : 'w-full']}>
      <span class:list={['flex items-center gap-0.5 text-xs font-medium leading-tight sm:text-sm', layout === 'tile' ? 'justify-center' : '']}>
        <span class={layout === "tile" ? "line-clamp-2 hyphens-auto" : "truncate"}>{t.data.name}</span>
        <Icon name="arrowUpRight" class="size-3 shrink-0 text-muted opacity-0 transition group-hover:opacity-100" />
      </span>
      <span class:list={['block text-xs leading-snug text-muted', layout === 'tile' ? 'line-clamp-2' : 'truncate', layout === 'tile' && !t.data.related_to_directory ? 'max-sm:hidden' : '']}>{sub}</span>
    </span>
  </a>
  <a href={details} class="tc-info" aria-label={`${t.data.name} details, price and alternatives`} title="Details">
    <Icon name="info" class="size-3.5" />
  </a>
  <PinButton kind="tool" id={t.id} name={t.data.name} href={details} class="tc-pin" />
  <div class="tc-preview" role="tooltip">
    <p class="font-medium text-ink">{t.data.name}</p>
    <p class="mt-0.5 text-muted">{t.data.tagline}</p>
    <p class="mt-1 text-ink">{priceLabel(t)}</p>
  </div>
</div>
