---
import Base from '../layouts/Base.astro';
import { SITE, isoDate } from '../lib/site';
import { categoryBySlug } from '../lib/taxonomy';
import { publisherRef } from '../lib/seo';
import { freeTool, FREE_TOOLS } from '../lib/freeTools';
import { getFacts } from '../lib/facts';

interface Props {
  slug: string;
  /** Page heading; defaults to the registry name. */
  title?: string;
  answer: string;
  faq?: { q: string; a: string }[];
  sources: string[];
  /** Name the KDPTop model or data the tool uses, when it does. */
  poweredBy?: string;
  /** The tool sends the visitor's input to a server. */
  remote?: boolean;
}
const { slug, answer, faq = [], sources, poweredBy, remote = false } = Astro.props;
const tool = freeTool(slug);
const title = Astro.props.title ?? tool.name;
const url = `${SITE.url}/free-tools/${slug}/`;
const facts = (await getFacts()).filter((f) => tool.facts.includes(f.id));
const others = FREE_TOOLS.filter((t) => t.slug !== slug);
const checked = isoDate(facts.map((f) => f.data.verified_at).filter((d) => d !== undefined).sort((a, b) => +b - +a)[0]);
const category = tool.category ? categoryBySlug(tool.category) : undefined;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description: tool.blurb,
    url,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any (runs in the browser)',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    publisher: publisherRef,
    citation: sources,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Free tools', item: `${SITE.url}/free-tools/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
if (faq.length)
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
  });
---

<Base title={title} titleVariants={[tool.seoTitle, title]} description={`${tool.blurb} Free, no sign-up.`} jsonLd={jsonLd} searchable>
  <nav class="text-sm text-muted" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/free-tools/">Free tools</a></nav>
  <article class="mt-2 max-w-3xl" data-pagefind-filter="type:Free tool" data-pagefind-meta="type:Free tool">
    <h1 class="text-4xl font-bold">{title}</h1>
    <p class="mt-2 text-sm text-muted">
      Free, no sign-up.{remote ? '' : ' Runs in your browser and sends nothing to us.'}{checked && <> Numbers checked against Amazon’s pages on <span data-pagefind-meta="checked">{checked}</span>.</>} Not affiliated with Amazon.
    </p>
    <p class="answer mt-4 leading-7">{answer}</p>

    <section class="mt-6 rounded-lg border border-line bg-white p-4 md:p-6" aria-label="Calculator">
      <slot />
    </section>

    {poweredBy && <p class="mt-3 text-sm text-muted">{poweredBy}</p>}

    <div class="prose-kdp mt-6"><slot name="how" /></div>

    {
      faq.length > 0 && (
        <>
          <h2 class="mt-10 text-2xl font-semibold">Questions</h2>
          <dl class="mt-3 space-y-4">
            {faq.map((x) => (
              <div>
                <dt class="font-medium">{x.q}</dt>
                <dd class="mt-1 leading-7">{x.a}</dd>
              </div>
            ))}
          </dl>
        </>
      )
    }

    {
      facts.length > 0 && (
        <>
          <h2 class="mt-10 text-2xl font-semibold">The rules behind it</h2>
          <ul class="mt-2 list-disc pl-6 leading-7">{facts.map((f) => <li><a href={`/facts/${f.id}/`}>{f.data.title}</a></li>)}</ul>
        </>
      )
    }

    <h2 class="mt-10 text-2xl font-semibold">Sources</h2>
    <ul class="mt-2 list-disc pl-6 text-sm">{sources.map((s) => <li><a href={s} rel="noopener">{s}</a></li>)}</ul>

    {category && (
      <>
        <h2 class="mt-10 text-2xl font-semibold">Need more than a calculator?</h2>
        <p class="mt-2 leading-7">Compare paid and free <a href={`/c/${category.slug}/`}>{category.name.toLowerCase()} tools</a>, each with its price, KDP fit and check date.</p>
      </>
    )}

    <h2 class="mt-10 text-2xl font-semibold">Other free tools</h2>
    <ul class="mt-2 list-disc pl-6 leading-7">{others.map((t) => <li><a href={`/free-tools/${t.slug}/`}>{t.name}</a></li>)}</ul>

    <p class="mt-8 text-sm text-muted">Found a wrong number? <a href="/submit/">Tell us</a>. The code is open on <a href={SITE.github}>GitHub</a>.</p>
  </article>
</Base>
