---
import { logoSrc, type Tool } from '../lib/site';

interface Props {
  tool: Tool;
  size?: number;
  class?: string;
}
const { tool, size = 32, class: cls = '' } = Astro.props;
const src = logoSrc(tool.id);
const hue = [...tool.id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
const radius = Math.round(size / 5);
---

{
  src ? (
    <img src={src} alt="" width={size} height={size} loading="lazy" decoding="async" class={`shrink-0 bg-white object-contain ${cls}`} style={`border-radius:${radius}px`} />
  ) : (
    <span
      aria-hidden="true"
      class={`inline-flex shrink-0 items-center justify-center font-bold text-white ${cls}`}
      style={`width:${size}px;height:${size}px;border-radius:${radius}px;font-size:${Math.round(size * 0.45)}px;background:hsl(${hue} 45% 42%)`}
    >
      {tool.data.name.replace(/^[^A-Za-z0-9]+/, '').charAt(0).toUpperCase()}
    </span>
  )
}
