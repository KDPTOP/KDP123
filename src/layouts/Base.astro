---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import CompareTray from '../components/CompareTray.astro';
import { SITE } from '../lib/site';
import { STAGES } from '../lib/taxonomy';
import { fitTitle, clampDescription, type Crumb } from '../lib/seo';
import mark from '../../public/logo-mark.svg?raw';

interface Props {
  title: string;
  /** Alternative titles, longest first; the first that fits in 60 characters with the brand wins. */
  titleVariants?: string[];
  /** Use the title exactly as given (the home page). */
  exactTitle?: boolean;
  description?: string;
  canonicalPath?: string;
  /** Set false on pages that should not declare a canonical URL (404). */
  canonical?: boolean;
  jsonLd?: object | object[];
  breadcrumbs?: Crumb[];
  type?: 'website' | 'article';
  /** ISO date of the last editorial check, for article:modified_time and the social image. */
  modified?: string;
  noindex?: boolean;
  markdownAlt?: string;
  /** Include this page in the Pagefind index. Off by default so list pages do not crowd out the pages they link to. */
  searchable?: boolean;
}
const {
  title,
  titleVariants,
  exactTitle = false,
  description = SITE.description,
  canonicalPath,
  canonical = true,
  jsonLd,
  breadcrumbs,
  type,
  modified,
  noindex = false,
  markdownAlt,
  searchable = false,
} = Astro.props;
const path = canonicalPath ?? Astro.url.pathname;
const fullTitle = exactTitle ? title : fitTitle(titleVariants ?? [title]);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const logoSvg = mark.replace('<svg ', '<svg aria-hidden="true" class="h-8 w-auto" ').replace(/ role="img" aria-label="KDP123"/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={fullTitle}
      description={clampDescription(description)}
      path={path}
      noindex={noindex}
      canonical={canonical}
      type={type}
      modified={modified}
      markdownAlt={markdownAlt}
      breadcrumbs={breadcrumbs}
      jsonLd={ld}
    />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-white focus:p-2">Skip to content</a>
    <header class="border-b border-line bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="flex items-center gap-2 no-underline hover:no-underline" aria-label="KDP123 home">
          <Fragment set:html={logoSvg} />
          <span class="text-xl font-extrabold tracking-tight text-ink">KDP<span class="text-brand">123</span></span>
        </a>
        <nav aria-label="Primary" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {STAGES.map((s) => <a href={`/stages/${s.slug}/`} class="text-ink">{s.name}</a>)}
          <a href="/facts/" class="font-medium">KDP facts</a>
          <a href="/free-tools/" class="font-medium">Free tools</a>
          <a href="/best/" class="font-medium">Guides</a>
          <a href="/research/" class="font-medium">Market data</a>
          <a href="/tools/" class="font-medium">All tools</a>
          <a href="/search/" class="text-ink">Search</a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-8" {...(searchable && !noindex ? { 'data-pagefind-body': '' } : {})}>
      <slot />
    </main>
    <footer class="mt-16 border-t border-line bg-white">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 text-sm text-muted md:grid-cols-4">
        <div>
          <img src="/logo-horizontal-light.svg" alt="KDP123" width="143" height="40" loading="lazy" />
          <p class="mt-3">{SITE.tagline}.</p>
          <p class="mt-2">Not affiliated with Amazon. "Amazon", "Kindle" and "KDP" are trademarks of Amazon.com, Inc.</p>
        </div>
        <div>
          <p class="font-semibold text-ink">Find tools</p>
          <ul class="mt-2 space-y-1">
            {STAGES.map((s) => <li><a href={`/stages/${s.slug}/`}>KDP {s.name.toLowerCase()} tools</a></li>)}
            <li><a href="/compare/pick/">Compare tools side by side</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-ink">About the data</p>
          <ul class="mt-2 space-y-1">
            <li><a href="/methodology/">Methodology and disclosures</a></li>
            <li><a href="/glossary/">KDP glossary</a></li>
            <li><a href="/data/">Open data (CC BY 4.0)</a></li>
            <li><a href="/changes/">Price and plan changes</a></li>
            <li><a href="/changelog/">Changelog and corrections</a></li>
            <li><a href="/sitemap/">Site map</a></li>
            <li><a href={SITE.github}>Source on GitHub (MIT)</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-ink">Follow and contribute</p>
          <ul class="mt-2 space-y-1">
            <li><a href="/newsletter/">Monthly email</a> · <a href="/rss.xml">RSS</a></li>
            <li><a href="/submit/">Suggest or correct a listing</a></li>
            <li><a href="/about/">About KDP123</a> · <a href="mailto:hello@kdp123.com">hello@kdp123.com</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
          <p class="mt-4 font-semibold text-ink">From the same team</p>
          <p class="mt-2"><a href={SITE.related.url} rel="noopener">KDPTop</a>: daily Amazon bestseller lists and KDP category research.</p>
        </div>
      </div>
    </footer>
    <CompareTray />
  </body>
</html>
