---
import '../styles/global.css';
import { SITE } from '../lib/site';
import { STAGES } from '../lib/taxonomy';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  markdownAlt?: string;
  /** Include this page in the Pagefind index. Off by default so list pages do not crowd out the pages they link to. */
  searchable?: boolean;
}
const { title, description = SITE.description, canonicalPath, jsonLd, noindex = false, markdownAlt, searchable = false } = Astro.props;
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path, SITE.url).toString();
const fullTitle = title === SITE.name ? `${SITE.name} - ${SITE.tagline}` : `${title} | ${SITE.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {markdownAlt && <link rel="alternate" type="text/markdown" href={markdownAlt} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-white focus:p-2">Skip to content</a>
    <header class="border-b border-line bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="font-serif text-xl font-bold text-ink no-underline hover:no-underline">kdp<span class="text-accent">123</span></a>
        <nav aria-label="Primary" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {STAGES.map((s) => <a href={`/stages/${s.slug}/`} class="text-ink">{s.name}</a>)}
          <a href="/facts/" class="font-medium">KDP facts</a>
          <a href="/free-tools/" class="font-medium">Free tools</a>
          <a href="/best/" class="font-medium">Guides</a>
          <a href="/research/" class="font-medium">Market data</a>
          <a href="/tools/" class="font-medium">All tools</a>
          <a href="/search/" class="text-ink">Search</a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-8" {...(searchable && !noindex ? { 'data-pagefind-body': '' } : {})}>
      <slot />
    </main>
    <footer class="mt-16 border-t border-line bg-white">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 text-sm text-muted md:grid-cols-3">
        <div>
          <p class="font-serif text-base font-semibold text-ink">kdp123</p>
          <p class="mt-2">{SITE.tagline}.</p>
          <p class="mt-2">Not affiliated with Amazon. "Amazon", "Kindle" and "KDP" are trademarks of Amazon.com, Inc.</p>
        </div>
        <div>
          <p class="font-semibold text-ink">About the data</p>
          <ul class="mt-2 space-y-1">
            <li><a href="/methodology/">Methodology and disclosures</a></li>
            <li><a href="/data/">Open data (CC BY 4.0)</a></li>
            <li><a href="/changes/">Price and plan changes</a></li>
            <li><a href="/changelog/">Changelog and corrections</a></li>
            <li><a href={SITE.github}>Source on GitHub (MIT)</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-ink">Contribute</p>
          <ul class="mt-2 space-y-1">
            <li><a href="/submit/">Suggest or correct a listing</a></li>
            <li><a href="/about/">About kdp123</a> · <a href="mailto:hello@kdp123.com">hello@kdp123.com</a></li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
          <p class="mt-4 font-semibold text-ink">From the same team</p>
          <p class="mt-2"><a href={SITE.related.url} rel="noopener">KDPTop</a>: daily Amazon bestseller lists and KDP category research.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
