    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDPTOP/KDP123.git"
  },
  "homepage": "https://kdp123.com",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.6.0",
