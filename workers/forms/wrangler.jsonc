{
  // Deployed to the kdp123 Cloudflare account; only handles the routes below.
  "name": "kdp123-forms",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "kdp123.com/api/suggest*", "zone_name": "kdp123.com" }],
  "workers_dev": false,
  // Without a destination restriction the binding can still only reach verified Email Routing addresses.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["forms@kdp123.com"] }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1231", "simple": { "limit": 5, "period": 60 } }],
  // Secrets (wrangler secret put): TURNSTILE_SECRET, TEAM_INBOX (a verified destination address).
  "observability": { "enabled": true }
}
